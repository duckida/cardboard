rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    match /boards/{boardId} {
      // Public screens: anyone with the URL can read the board.
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /announcements/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /assets/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /screens/{id} {
        allow read: if true;
        // An admin adds screens; a screen may also register itself on first boot.
        allow create: if isAdmin() || signedIn();
        // Anonymous screens may only touch presence fields.
        allow update: if isAdmin() ||
          (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastSeen', 'pageId', 'meta']));
        allow delete: if isAdmin();

        match /commands/{cmdId} {
          allow read: if signedIn();
          allow create: if isAdmin();
          allow delete: if signedIn();
        }
      }

      // Written only by the Admin SDK (Vercel functions).
      match /scheduleMeta/{id} {
        allow read: if true;
        allow write: if false;
      }
      match /scheduleCache/{id} {
        allow read: if true;
        allow write: if false;
      }

      match /revisions/{id} {
        allow read, write: if isAdmin();
      }

      // Calendar URLs and other secrets. Admin SDK only.
      match /private/{doc} {
        allow read, write: if false;
      }
    }
  }
}
