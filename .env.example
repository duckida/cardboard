# ── Demo mode ────────────────────────────────────────────────────────────────
# Runs entirely in localStorage with no Firebase project. Set to 1 for a first look.
VITE_DEMO=0
VITE_DEMO_PASSWORD=cardboard

# ── Firebase web config (safe to expose; these are public identifiers) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional: point the app at local emulators
VITE_USE_EMULATORS=0

# Board document id under /boards
VITE_BOARD_ID=main

# Only used as a UI convenience; Firestore rules require the admin custom claim.
VITE_ADMIN_EMAIL=

# ── Server-side (Vercel env, never VITE_*) ───────────────────────────────────
# Firebase service account JSON for the same project as VITE_FIREBASE_PROJECT_ID.
# Single line, pretty-printed, or base64-encoded are all accepted.
# Required for art teacher accounts and uploads.
FIREBASE_SERVICE_ACCOUNT=
ADMIN_EMAIL=

# Hack Club CDN API key: https://cdn.hackclub.com/api_keys
HACKCLUB_CDN_KEY=
